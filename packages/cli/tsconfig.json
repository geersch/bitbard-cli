{
  "extends": "@bitbard/typescript-config/base.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "@bitbard/core/*.js": ["../core/src/*.ts"],
      "@bitbard/spotify/*.js": ["../spotify/src/*.ts"],
      "@bitbard/unifi/*.js": ["../unifi/src/*.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
