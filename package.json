{
  "name": "bitbard",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.2.13",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "test": "turbo test",
    "check-types": "turbo check-types",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "quality": "turbo run quality",
    "quality:fix": "turbo run quality:fix"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "turbo": "^2.5.3",
    "typescript": "^6.0.3"
  }
}
